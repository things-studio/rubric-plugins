{
  "description": "Refuse a submission with no annotated screenshots, and steer the report to HTML. One refusal each, then out of the way.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(submit_findings|get_report|create_annotations)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rubric-audit-guard.js\"",
            "timeout": 10,
            "statusMessage": "Rubric audit guard"
          }
        ]
      }
    ]
  }
}
